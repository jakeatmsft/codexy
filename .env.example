# Exported environment variables take precedence over this file.
CODEXY_AUTH_MODE=entra
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=YOUR-DEPLOYMENT
# Optional: use a Foundry resource endpoint ending in .services.ai.azure.com.
# Both a resource root and a URL ending in /openai/v1/ are accepted.

# Sign in first with: az login
# Optional Azure CLI account selection/configuration:
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_CONFIG_DIR=
AZURE_CLI_COMMAND=az
AZURE_TOKEN_RESOURCE=https://cognitiveservices.azure.com/

# Optional deployment override. --model takes precedence over this setting.
CODEXY_MODEL=
CODEXY_APPROVAL_MODE=suggest
OPENAI_TIMEOUT_MS=60000
CODEXY_CHECK_UPDATES=false
CODEXY_DISABLE_PROJECT_DOC=false
CODEXY_FULL_STDOUT=false
CODEXY_NOTIFY=false

# Optional alternative: an OpenAI-compatible API-key backend.
# CODEXY_AUTH_MODE=api-key
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CODEXY_MODEL=o4-mini
